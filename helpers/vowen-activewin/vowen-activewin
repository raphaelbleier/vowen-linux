def list_browsers():
    idx, out = load_index(), []
    for key, (ids, fam, _d) in BROWSERS.items():
        e = next((idx[i] for i in ids if i in idx), None)
        if e and e["bin"]:
            out.append({"key": key, "name": NAMES[key], "family": fam, "path": shutil.which(e["bin"]) or e["bin"],
                        "bundleId": e["id"], "icon": icon_data(e["icon"]),
                        "hasProfiles": len(list_profiles(key)) > 1})
    return sorted(out, key=lambda b: b["name"].lower())


def list_profiles(key):
    if key not in BROWSERS:
        return []
    fam, d = BROWSERS[key][1], BROWSERS[key][2]
    bases = [os.path.expanduser(x) if x.startswith("~") else os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), x)
             for x in d.split("|")]
    base = next((b for b in bases if os.path.exists(os.path.join(b, "profiles.ini" if fam == "gecko" else "Local State"))), bases[0])
    try:
        if fam == "chromium":
            with open(os.path.join(base, "Local State"), encoding="utf-8") as f:
                prof = json.load(f).get("profile", {})
            cache, order = prof.get("info_cache") or {}, prof.get("profiles_order") or []
            keys = [k for k in order if k in cache] + [k for k in cache if k not in order]
            return [{"dir": k, "name": cache[k].get("name") or k, "email": cache[k].get("user_name") or None}
                    for k in keys if not cache[k].get("is_ephemeral")]
        names, sect = [], None
        with open(os.path.join(base, "profiles.ini"), encoding="utf-8") as f:
            for ln in f:
                ln = ln.strip()
                m = re.match(r"^\[(.+)\]$", ln)
                if m:
                    sect = m.group(1)
                elif sect and re.match(r"Profile\d+$", sect, re.I) and ln.lower().startswith("name="):
                    names.append(ln.split("=", 1)[1].strip())
        return [{"dir": n, "name": n, "email": None} for n in names]
    except (OSError, ValueError, AttributeError):
        return []


def main(argv):
    os.closerange(3, 256)  # do not keep fds inherited from the Electron parent
    a = argv[1:]
    if not a or a[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    cmd = a[0]
    if cmd == "--watch":
        return watch("--parent-stdin" in a)
    if cmd == "--cursor-watch":
        return cursor_watch("--parent-stdin" in a)
    if cmd in ("--get", "--cursor"):
        what = cmd[2:]
        out = query_daemon("get" if what == "get" else "cursor") or direct("get" if what == "get" else "cursor")
        print(json.dumps(out if out is not None else ({"error": "unavailable"} if what == "cursor" else dict(EMPTY))))
        return 0
    if cmd == "--list-apps":
        print(json.dumps(list_apps()))
    elif cmd == "--list-browsers":
        print(json.dumps(list_browsers()))
    elif cmd == "--icon" and len(a) > 1:
        e = load_index().get(a[1].lower())
        print(json.dumps({"icon": icon_data(e["icon"]) if e else None}))
    elif cmd == "--list-profiles" and len(a) > 1:
        print(json.dumps(list_profiles(a[1])))
    else:
        print("unknown option", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
